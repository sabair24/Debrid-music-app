<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- "Test buitenverbinding": één verzoek over mobiele data terwijl wifi aan staat (requestNetwork). Een gewone toestemming, zonder vraag aan de gebruiker. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
    <!-- Bonjour/mDNS. Without the multicast lock the PC is simply never discovered, and the
         failure looks exactly like the PC being switched off. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Playback that survives the screen going off, which on a phone is the normal case. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- De Shield vindbaar en wekbaar terwijl hij slaapt (Ontvanger.kt): de dienst die luistert, opnieuw starten na
         een herstart, en de app vooraan zetten als er muziek binnenkomt. Dat laatste mag een app op de achtergrond
         alleen met "weergeven over andere apps"; op de Shield gegeven via adb, zoals bij Debrid Media. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <!-- Bijwerken vanuit de app zelf. Zonder dit recht opent het installatiescherm en sluit het
         meteen weer, zonder een woord — wat leest als een update die stuk is. Het is bovendien een
         recht dat de gebruiker per app moet aanzetten; de app vraagt er zelf om, één keer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <!-- Wat je op dit toestel bewaart, in een echte map: Muziek/Debrid Music, met de indeling van de pc (Saber,
         28-10-2026: "ik moet ook direct naar de map kunnen gaan"). "Toegang tot alle bestanden" zodat de app die map
         ook na een herinstallatie kan herkennen, vervangen en opruimen; Saber zet het zelf aan, de app vraagt het
         één keer. Onder Android 11 de gewone schrijfrechten. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32"/>

    <!-- One APK for the phone and the TV. A Shield has no touchscreen, and required="true" — the
         default — would hide the app from its store and its launcher entirely. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <!-- Declared only to say it is NOT required. Asking for CHANGE_WIFI_MULTICAST_STATE above makes
         Android imply `android.hardware.wifi required="true"` on your behalf — confirmed in the
         built APK's badging as "uses-implied-feature". That would hide the app from every television
         that is on ethernet only, for a permission this app uses to find a PC that is usually on the
         same cable. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false"/>

    <!-- android:enableOnBackInvokedCallback zet terugvegen mét voorvertoning aan: je ziet het vorige
         scherm al terwijl je veegt, in plaats van een harde knip als je loslaat. Vanaf Android 13
         alleen als een app het zelf aanzet. De app was er al klaar voor (PopScope met
         onPopInvokedWithResult); dit attribuut ontbrak. -->
    <application
        android:label="DebridMusic"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="true">
        <!-- android:banner is here as well as on <application>. PackageManager does fall back to the
             application's banner, but a leanback launcher reads the activity's first, and the built
             APK reported `leanback-launchable-activity: banner=''`.

             navigation|touchscreen|colorMode in configChanges are for the television. A remote or a
             controller pairing or dropping changes `navigation`; an AVR waking up or the set
             switching input changes `colorMode`. Without them Android destroys and rebuilds the
             activity: the music keeps playing from the service, but the screen jumps back to the
             start and the page you were on is gone — which reads as a crash. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:banner="@drawable/tv_banner"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|touchscreen|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode|colorMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The same activity, reached from a TV launcher. Two filters rather than two
                 activities: it is one app, and a second entry point is a second thing to keep
                 in step. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- De albumhoezen voor Android Auto.

             Auto draait in een ánder proces en laadt de artUri zélf; een `file:`-pad in onze
             privémap kan hij niet openen, en dat gaf grijze vlakken in plaats van je platenkast.

             HIER STOND EERST `androidx.core.content.FileProvider` MET exported="true". Dat kan
             niet, en het faalt op de duurste manier die er is — niet bij het bouwen maar bij élke
             start van de app, op de telefoon, ná het installeren:

                 java.lang.RuntimeException: Unable to get provider FileProvider
                 Caused by: java.lang.SecurityException: Provider must not be exported
                     at androidx.core.content.FileProvider.attachInfo

             Vandaar HoesProvider.kt, van onszelf: die kent die controle niet. Wat hij deelt staat
             daar uitgeschreven — één map, alleen lezen, alleen namen van zestien hexcijfers.

             grantUriPermissions is niet nodig en staat er daarom niet: de provider is geëxporteerd,
             dus er valt niets toe te kennen. -->
        <provider
            android:name=".HoesProvider"
            android:authorities="${applicationId}.hoezen"
            android:exported="true"/>

        <!-- De TWEEDE provider, en met opzet precies andersom ingesteld dan die hierboven.

             Deze bestaat voor het installatiescherm: een `file://`-URI mag sinds Android 7 niet meer
             buiten de app (FileUriExposedException), dus de APK moet als `content://` doorgegeven
             worden. Dat is precies waar androidx' FileProvider voor is.

             exported="false" is HIER GEEN DETAIL. Diezelfde klasse crasht de app bij elke start als
             hij wél geëxporteerd wordt — dat staat hierboven uitgeschreven. Het installatiescherm
             heeft die export ook niet nodig: het krijgt eenmalig leesrecht mee via
             FLAG_GRANT_READ_URI_PERMISSION, en daarvoor moet grantUriPermissions juist wél aan.

             Twee providers, twee tegengestelde instellingen, twee verschillende redenen. Wie ze
             gelijk probeert te trekken, breekt er één van. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.apk"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/apk_paden"/>
        </provider>

        <!-- Android Auto. Dit is wat de app ZICHTBAAR maakt in de auto.

             Alles wat nodig is om te spelen zat er al — de MediaBrowserService hieronder, de
             mediaknoppen, de audiosessie. Alleen keek Auto eerst hiernaar, vond niets, en toonde de
             app dus nergens: geen foutmelding, geen aanwijzing, gewoon afwezig. Zie
             res/xml/automotive_app_desc.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc"/>

        <!-- audio_service: what the lockscreen, the notification and the media keys talk to.
             libmpv still plays the audio; this only publishes what is playing and hands the
             buttons back. Dit is ook de service waarmee Android Auto praat: hij bladert erin via
             MediaBrowserService en start nummers via playFromMediaId. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- De Shield vindbaar terwijl hij slaapt (Saber, 31-10-2026; zie Ontvanger.kt). Een voorgronddienst houdt het
             netwerk van de app open in Doze: gemeten REJECT_ALL zonder, ALLOW_ALL met. connectedDevice en niet
             mediaPlayback: hij luistert, hij speelt niet, en vanaf Android 15 mag een mediaPlayback-dienst niet meer
             starten na het opstarten van het toestel. Alleen op een televisie gestart. -->
        <service
            android:name=".OntvangerDienst"
            android:foregroundServiceType="connectedDevice"
            android:exported="false"/>
        <!-- En na een herstart of een update opnieuw, zonder dat iemand de app opent. -->
        <receiver
            android:name=".OntvangerStart"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
