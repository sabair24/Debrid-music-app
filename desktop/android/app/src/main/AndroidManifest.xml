<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- Bonjour/mDNS. Without the multicast lock the PC is simply never discovered, and the
         failure looks exactly like the PC being switched off. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
    <!-- Playback that survives the screen going off, which on a phone is the normal case. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- One APK for the phone and the TV. A Shield has no touchscreen, and required="true" — the
         default — would hide the app from its store and its launcher entirely. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <!-- Declared only to say it is NOT required. Asking for CHANGE_WIFI_MULTICAST_STATE above makes
         Android imply `android.hardware.wifi required="true"` on your behalf — confirmed in the
         built APK's badging as "uses-implied-feature". That would hide the app from every television
         that is on ethernet only, for a permission this app uses to find a PC that is usually on the
         same cable. -->
    <uses-feature android:name="android.hardware.wifi" android:required="false"/>

    <application
        android:label="DebridMusic"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:banner="@drawable/tv_banner"
        android:usesCleartextTraffic="true">
        <!-- android:banner is here as well as on <application>. PackageManager does fall back to the
             application's banner, but a leanback launcher reads the activity's first, and the built
             APK reported `leanback-launchable-activity: banner=''`.

             navigation|touchscreen|colorMode in configChanges are for the television. A remote or a
             controller pairing or dropping changes `navigation`; an AVR waking up or the set
             switching input changes `colorMode`. Without them Android destroys and rebuilds the
             activity: the music keeps playing from the service, but the screen jumps back to the
             start and the page you were on is gone — which reads as a crash. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:banner="@drawable/tv_banner"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|navigation|touchscreen|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode|colorMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- The same activity, reached from a TV launcher. Two filters rather than two
                 activities: it is one app, and a second entry point is a second thing to keep
                 in step. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- De albumhoezen voor Android Auto.

             Auto draait in een ánder proces en kan geen `file:`-pad in de privémap van deze app
             lezen; zonder dit krijg je grijze vlakken in plaats van je platenkast. Een content-URI
             kan hij wél openen.

             `exported` staat op true en dat is een bewuste afweging, uitgeschreven in
             res/xml/auto_hoezen.xml: de provider deelt precies één submap met uitsluitend
             albumhoezen. Netter zou een toekenning per URI zijn, maar die moet vanuit platformcode
             gebeuren op het moment dat Auto bladert — en die MediaBrowserService is van
             `audio_service`, niet van ons. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.hoezen"
            android:exported="true"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/auto_hoezen"/>
        </provider>

        <!-- Android Auto. Dit is wat de app ZICHTBAAR maakt in de auto.

             Alles wat nodig is om te spelen zat er al — de MediaBrowserService hieronder, de
             mediaknoppen, de audiosessie. Alleen keek Auto eerst hiernaar, vond niets, en toonde de
             app dus nergens: geen foutmelding, geen aanwijzing, gewoon afwezig. Zie
             res/xml/automotive_app_desc.xml. -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc"/>

        <!-- audio_service: what the lockscreen, the notification and the media keys talk to.
             libmpv still plays the audio; this only publishes what is playing and hands the
             buttons back. Dit is ook de service waarmee Android Auto praat: hij bladert erin via
             MediaBrowserService en start nummers via playFromMediaId. -->
        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
